# Vercel AI Gateway Configuration
# Put your permanent AI Gateway API key here.
# Never commit this file or your .env.local to Git.
AI_GATEWAY_API_KEY=

# Model Configuration
# Realtime Voice Model (production-quality model supported by Vercel AI Gateway)
REALTIME_MODEL=openai/gpt-realtime-2

# Structured Evaluation & Classification Model
EVALUATION_MODEL=openai/gpt-4o-mini
